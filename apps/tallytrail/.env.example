# --- Local JSON storage (default for tests and offline dev) ---
TALLYTRAIL_STORAGE=json
# Optional absolute directory for JSON + local evidence files (default: apps/tallytrail/.data)
TALLYTRAIL_DATA_DIR=

# --- Hosted storage (Neon Postgres) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Neon Auth (required when DATABASE_URL is set) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# --- Private bill files on Vercel (required when DATABASE_URL is set) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional Gemini extraction (disabled unless exactly true AND key present) ---
TALLYTRAIL_GEMINI_ENABLED=false
GEMINI_API_KEY=

# --- Solana devnet (optional; server signs after report confirmation) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
# JSON array secret key bytes, or a path on your machine (never commit):
SOLANA_WALLET_JSON=
SOLANA_WALLET_PATH=
# Tests use in-memory chain mock instead of RPC:
TALLYTRAIL_CHAIN_MOCK=
